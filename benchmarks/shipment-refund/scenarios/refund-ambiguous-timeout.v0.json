      "id": "refund-ack-lost",
      "kind": "ambiguous_post_commit_timeout",
      "match": {
        "tool_id": "payments.refund",
        "phase": "after_commit",
        "call_ordinal": 1,
        "argument_equals": { "order_id": "ORD-1007" }
      },
      "activation": { "probability_ppm": 1000000, "max_occurrences": 1 },
      "parameters": { "duration_ms": 5000 }
    }
  ],
  "budgets": {
    "max_steps": 12,
    "max_tool_calls": 10,
    "max_wall_time_ms": 120000,
    "max_cost_microusd": 250000
