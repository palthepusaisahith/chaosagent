      "Apply the referenced refund policy and request approval when required.",
      "Create at most one refund and update the ticket with claims supported by tool results."
    ],
    "allowed_tools": [
      "orders.get",
      "shipping.get_status",
      "payments.refund",
      "support.update_ticket"
