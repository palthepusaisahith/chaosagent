{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chaosagent.dev/fixture/v0/schema.json",
  "title": "ChaosAgent Synthetic Company Fixture v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "revision",
    "metadata",
    "reference_time",
    "customers",
    "orders",
    "shipments",
    "payments",
    "refunds",
    "support_tickets"
  ],
  "properties": {
    "schema_version": { "const": "chaosagent.fixture/v0" },
    "fixture_id": { "$ref": "#/$defs/contract_id" },
    "revision": { "$ref": "#/$defs/revision" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "reference_time": { "$ref": "#/$defs/timestamp" },
    "customers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "x-chaosagent-array-semantics": "set-by-customer_id",
      "items": { "$ref": "#/$defs/customer" }
    },
    "orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "x-chaosagent-array-semantics": "set-by-order_id",
      "items": { "$ref": "#/$defs/order" }
    },
    "shipments": {
      "type": "array",
      "maxItems": 5000,
      "x-chaosagent-array-semantics": "set-by-shipment_id",
      "items": { "$ref": "#/$defs/shipment" }
    },
    "payments": {
      "type": "array",
      "maxItems": 5000,
      "x-chaosagent-array-semantics": "set-by-payment_id",
      "items": { "$ref": "#/$defs/payment" }
    },
    "refunds": {
      "type": "array",
      "maxItems": 10000,
      "x-chaosagent-array-semantics": "set-by-refund_id",
      "items": { "$ref": "#/$defs/refund" }
    },
    "support_tickets": {
      "type": "array",
      "maxItems": 5000,
      "x-chaosagent-array-semantics": "set-by-ticket_id",
      "items": { "$ref": "#/$defs/support_ticket" }
    }
  },
  "$defs": {
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "minor_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_id", "name", "email", "status"],
      "properties": {
        "customer_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "email": { "type": "string", "minLength": 3, "maxLength": 320 },
        "status": { "enum": ["active", "suspended"] }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "customer_id",
        "status",
        "currency",
        "total_minor",
        "placed_at"
      ],
      "properties": {
        "order_id": { "$ref": "#/$defs/id" },
        "customer_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["placed", "paid", "fulfilled", "cancelled"] },
        "currency": { "$ref": "#/$defs/currency" },
        "total_minor": { "$ref": "#/$defs/minor_units" },
        "placed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "shipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shipment_id",
        "order_id",
        "status",
        "carrier",
        "tracking_number",
        "updated_at"
      ],
      "properties": {
        "shipment_id": { "$ref": "#/$defs/id" },
        "order_id": { "$ref": "#/$defs/id" },
        "status": {
          "enum": ["pending", "in_transit", "delivered", "failed", "returned"]
        },
        "carrier": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tracking_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_id",
        "order_id",
        "status",
        "currency",
        "amount_minor",
        "captured_at"
      ],
      "properties": {
        "payment_id": { "$ref": "#/$defs/id" },
        "order_id": { "$ref": "#/$defs/id" },
        "status": {
          "enum": ["captured", "partially_refunded", "refunded"]
        },
        "currency": { "$ref": "#/$defs/currency" },
        "amount_minor": { "$ref": "#/$defs/minor_units" },
        "captured_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refund_id",
        "payment_id",
        "order_id",
        "status",
        "amount_minor",
        "reason",
        "created_at"
      ],
      "properties": {
        "refund_id": { "$ref": "#/$defs/id" },
        "payment_id": { "$ref": "#/$defs/id" },
        "order_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pending", "succeeded", "failed"] },
        "amount_minor": { "$ref": "#/$defs/minor_units" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "support_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_id",
        "customer_id",
        "order_id",
        "status",
        "subject",
        "note",
        "updated_at"
      ],
      "properties": {
        "ticket_id": { "$ref": "#/$defs/id" },
        "customer_id": { "$ref": "#/$defs/id" },
        "order_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["open", "pending", "closed"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
        "note": { "type": "string", "maxLength": 4000 },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
