{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chaosagent.dev/ground-truth/v0/schema.json",
  "title": "ChaosAgent Ground Truth v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ground_truth_id",
    "revision",
    "metadata",
    "critical_gates"
  ],
  "properties": {
    "schema_version": { "const": "chaosagent.ground-truth/v0" },
    "ground_truth_id": { "$ref": "#/$defs/catalogId" },
    "revision": { "$ref": "#/$defs/revision" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "critical_gates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "x-chaosagent-array-semantics": "set-by-gate_id",
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "refundGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "kind",
        "order_id",
        "payment_id",
        "amount_minor",
        "currency",
        "status",
        "min_count",
        "max_count"
      ],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "const": "refund_state" },
        "order_id": { "$ref": "#/$defs/id" },
        "payment_id": { "$ref": "#/$defs/id" },
        "amount_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "status": { "enum": ["pending", "succeeded", "failed"] },
        "min_count": { "$ref": "#/$defs/count" },
        "max_count": { "$ref": "#/$defs/count" }
      }
    },
    "ticketGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "ticket_id", "order_id", "status"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "const": "support_ticket_state" },
        "ticket_id": { "$ref": "#/$defs/id" },
        "order_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["open", "pending", "closed"] },
        "note_contains": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "effectCountGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "effect_kind", "min_count", "max_count"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "const": "effect_count" },
        "effect_kind": { "enum": ["refund.created", "support_ticket.updated"] },
        "min_count": { "$ref": "#/$defs/count" },
        "max_count": { "$ref": "#/$defs/count" }
      }
    },
    "effectKindGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "effect_kinds"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "enum": ["authorization_respected", "required_approval"] },
        "effect_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "x-chaosagent-array-semantics": "set",
          "items": { "enum": ["refund.created", "support_ticket.updated"] }
        }
      }
    },
    "claimGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "claim_text", "supporting_effect"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "const": "claim_supported" },
        "claim_text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "supporting_effect": { "$ref": "#/$defs/claimEffect" }
      }
    },
    "claimEffect": {
      "oneOf": [
        { "$ref": "#/$defs/refundClaimEffect" },
        { "$ref": "#/$defs/ticketClaimEffect" }
      ]
    },
    "refundClaimEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_kind", "subject_type", "result_equals"],
      "properties": {
        "effect_kind": { "const": "refund.created" },
        "subject_type": { "const": "refund" },
        "subject_id": { "$ref": "#/$defs/id" },
        "result_equals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order_id",
            "payment_id",
            "amount_minor",
            "currency",
            "status"
          ],
          "properties": {
            "refund_id": { "$ref": "#/$defs/id" },
            "order_id": { "$ref": "#/$defs/id" },
            "payment_id": { "$ref": "#/$defs/id" },
            "amount_minor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "status": { "enum": ["pending", "succeeded", "failed"] }
          }
        }
      }
    },
    "ticketClaimEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_kind", "subject_type", "result_equals"],
      "properties": {
        "effect_kind": { "const": "support_ticket.updated" },
        "subject_type": { "const": "support_ticket" },
        "subject_id": { "$ref": "#/$defs/id" },
        "result_equals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ticket_id", "status"],
          "properties": {
            "ticket_id": { "$ref": "#/$defs/id" },
            "status": { "enum": ["open", "pending", "closed"] },
            "note": { "type": "string", "maxLength": 2000 }
          }
        }
      }
    },
    "faultGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "fault_ids"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "const": "fault_observed" },
        "fault_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "x-chaosagent-array-semantics": "set",
          "items": { "$ref": "#/$defs/catalogId" }
        }
      }
    },
    "simpleGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/catalogId" },
        "kind": { "const": "budgets_satisfied" }
      }
    },
    "gate": {
      "oneOf": [
        { "$ref": "#/$defs/refundGate" },
        { "$ref": "#/$defs/ticketGate" },
        { "$ref": "#/$defs/effectCountGate" },
        { "$ref": "#/$defs/effectKindGate" },
        { "$ref": "#/$defs/claimGate" },
        { "$ref": "#/$defs/faultGate" },
        { "$ref": "#/$defs/simpleGate" }
      ]
    }
  }
}
